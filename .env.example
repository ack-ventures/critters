# Anthropic API key (required for Claude Code CLI in Docker; interactive auth uses ~/.claude instead)
# ANTHROPIC_API_KEY=sk-ant-xxx

LINEAR_API_KEY=lin_api_xxx
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Slack Bot Token (optional, enables threaded notifications)
# SLACK_BOT_TOKEN=xoxb-xxx
# SLACK_CHANNEL=C0123456789

# Jira Cloud credentials (required when using provider: jira)
# JIRA_HOST=mycompany.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=your-jira-api-token

# Dashboard bearer token (optional, protects POST endpoints)
# DASHBOARD_TOKEN=your-secret-token

# Webhook secrets (optional, enables near-instant issue pickup via webhooks)
# LINEAR_WEBHOOK_SECRET=your-linear-webhook-signing-secret
# JIRA_WEBHOOK_SECRET=your-jira-webhook-secret
