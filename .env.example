LINEAR_API_KEY=lin_api_xxx
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Slack Bot Token (optional, enables threaded notifications)
# SLACK_BOT_TOKEN=xoxb-xxx
# SLACK_CHANNEL=C0123456789

# Jira Cloud credentials (required when using provider: jira)
# JIRA_HOST=mycompany.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=your-jira-api-token

# Dashboard bearer token (optional, protects POST endpoints)
# DASHBOARD_TOKEN=your-secret-token
